# Google Gemini API Key (Get a free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Unsplash API Access Key (Get one at https://unsplash.com/developers → New Application)
# Free tier: 50 requests/hour, which is sufficient for the hourly pipeline.
# The key is public (client-side), not a secret — but keep it private to avoid quota theft.
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
