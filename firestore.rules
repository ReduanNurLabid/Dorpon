rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function for authorized editor
    function isEditor() {
      return request.auth != null && 
        (request.auth.token.email == 'nurreduan.pp@gmail.com' || 
         request.auth.token.email == 'reduannurlabid@gmail.com');
    }

    // =========================================================================
    // Default Deny Rule
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Public Read-Only Feeds & Editor Full Control
    // =========================================================================
    // 1. Daily 60-second news stories feed
    match /daily_buzz/{storyId} {
      allow read: if true;
      allow write: if isEditor();
    }

    // 2. Breaking hourly wires feed
    match /hourly_buzz/{wireId} {
      allow read: if true;
      allow write: if isEditor();
    }

    // 3. BCS Pro published syllabus-mapped guides and daily editions
    match /bcs_pro_published/{editionId} {
      allow read: if true;
      allow write: if isEditor();
    }

    // 4. Current Affairs published editorial editions and latest summary
    match /current_affairs_published/{editionId} {
      allow read: if true;
      allow write: if isEditor();
    }

    // =========================================================================
    // Internal & Staging Collections
    // =========================================================================
    match /bcs_pro_drafts/{draftId} {
      allow read, write: if isEditor();
    }
  }
}
